modules = ["python-3.11", "nodejs-24", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "gitFull", "glibcLocales", "gnumeric", "playwright-driver", "postgresql", "tesseract", "poppler", "antiword", "chromium", "noto-fonts-cjk-sans"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "exec gunicorn --config gunicorn.conf.py 'src.production:create_production_app()'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[objectStorage]
defaultBucketID = "replit-objstore-754f24c5-7338-492d-84e3-257610894722"

[userenv]

[userenv.shared]
STORAGE_BACKEND = "postgres"
WHATSAPP_PHONE_NUMBER_ID = "1441593582361913"

[deployment]
deploymentTarget = "vm"
run = ["gunicorn", "--config", "gunicorn.conf.py", "src.production:create_production_app()"]
build = ["bash", "scripts/build-production.sh"]
